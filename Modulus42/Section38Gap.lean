def section38GapWitness : ℤ := 60784530626

theorem section38Gap_rejects :
    section38GapFamilies.all (fun f => f.rejects section38GapWitness) = true := by decide +kernel

theorem section38Gap_not_covered :
    ∀ f ∈ section38GapFamilies, ¬ f.Matches section38GapWitness := by
  intro f hf
  exact f.not_matches_of_rejects _ ((List.all_eq_true.mp section38Gap_rejects) f hf)

theorem section38Gap_avoids_centers :
    section38GapFamilies.all (fun f => f.avoidsCenters section38GapWitness) = true := by decide +kernel

theorem section38Gap_not_center :
    ∀ f ∈ section38GapFamilies, ∀ pc ∈ f, ¬ pc.2.IsRayCenter section38GapWitness := by
  intro f hf
  exact f.not_center_of_avoidsCenters _ ((List.all_eq_true.mp section38Gap_avoids_centers) f hf)

theorem section38Gap_target :
    section38GapWitness % 4 = 2 ∧ section38GapWitness % 5 = 1 ∧
    section38GapWitness % 11 = 6 ∧ section38GapWitness % 17 = 1 := by decide +kernel

/-- The target is not covered even if every exact arrow center is allowed. -/
theorem section38Gap_coverage_claim_fails :
    ¬ (∀ z : ℤ, z % 4 = 2 → z % 5 = 1 →
      (∃ f ∈ section38GapFamilies, f.Matches z) ∨
      ∃ f ∈ section38GapFamilies, ∃ pc ∈ f, pc.2.IsRayCenter z) := by
  intro h
  rcases h section38GapWitness section38Gap_target.1 section38Gap_target.2.1 with h | h
  · obtain ⟨f, hf, hm⟩ := h
    exact section38Gap_not_covered f hf hm
  · obtain ⟨f, hf, pc, hpc, hc⟩ := h
    exact section38Gap_not_center f hf pc hpc hc

