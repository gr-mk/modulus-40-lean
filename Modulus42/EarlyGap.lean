def earlyGapWitness : ℤ := 3743546626

theorem earlyGap_rejects :
    earlyGapFamilies.all (fun f => f.rejects earlyGapWitness) = true := by decide +kernel

theorem earlyGap_not_covered :
    ∀ f ∈ earlyGapFamilies, ¬ f.Matches earlyGapWitness := by
  intro f hf
  exact f.not_matches_of_rejects _ ((List.all_eq_true.mp earlyGap_rejects) f hf)

theorem earlyGap_avoids_centers :
    earlyGapFamilies.all (fun f => f.avoidsCenters earlyGapWitness) = true := by decide +kernel

theorem earlyGap_not_center :
    ∀ f ∈ earlyGapFamilies, ∀ pc ∈ f, ¬ pc.2.IsRayCenter earlyGapWitness := by
  intro f hf
  exact f.not_center_of_avoidsCenters _ ((List.all_eq_true.mp earlyGap_avoids_centers) f hf)

theorem earlyGap_target :
    earlyGapWitness % 4 = 2 ∧ earlyGapWitness % 5 = 1 ∧
    earlyGapWitness % 11 = 6 ∧ earlyGapWitness % 17 = 1 := by decide +kernel

/-- The target is not covered even if every exact arrow center is allowed. -/
theorem earlyGap_coverage_claim_fails :
    ¬ (∀ z : ℤ, z % 4 = 2 → z % 5 = 1 →
      (∃ f ∈ earlyGapFamilies, f.Matches z) ∨
      ∃ f ∈ earlyGapFamilies, ∃ pc ∈ f, pc.2.IsRayCenter z) := by
  intro h
  rcases h earlyGapWitness earlyGap_target.1 earlyGap_target.2.1 with h | h
  · obtain ⟨f, hf, hm⟩ := h
    exact earlyGap_not_covered f hf hm
  · obtain ⟨f, hf, pc, hpc, hc⟩ := h
    exact earlyGap_not_center f hf pc hpc hc

end Modulus42
